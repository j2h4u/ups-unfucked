#!/usr/bin/env python3
"""One-shot offline Release-A to reference-0 model transformation."""

import argparse
import json
import sys
from dataclasses import asdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from src.adapters.model_transform import (
    ModelTransformError,
    TransformSettings,
    transform_model_file,
)
from src.battery_math.constants import RATED_CAPACITY_AH


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Atomically transform a registered Release-A model to the reference-0 schema"
    )
    parser.add_argument("--model", required=True, type=Path)
    parser.add_argument("--backup", required=True, type=Path)
    parser.add_argument("--source-fingerprint", required=True)
    parser.add_argument("--target-fingerprint", required=True)
    parser.add_argument("--shutdown-minutes", required=True, type=float)
    parser.add_argument("--rated-capacity-ah", type=float, default=RATED_CAPACITY_AH)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        receipt = transform_model_file(
            args.model,
            backup_path=args.backup,
            registered_source_fingerprint=args.source_fingerprint,
            registered_target_fingerprint=args.target_fingerprint,
            settings=TransformSettings(
                shutdown_threshold_minutes=args.shutdown_minutes,
                rated_capacity_ah=args.rated_capacity_ah,
            ),
        )
    except ModelTransformError as exc:
        sys.stderr.write(f"reference transform refused: {exc}\n")
        return 2
    payload = asdict(receipt)
    payload["backup_path"] = str(receipt.backup_path)
    sys.stdout.write(json.dumps(payload, ensure_ascii=True, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
