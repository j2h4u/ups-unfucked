[Unit]
Description=UPS Battery Monitor
Documentation=https://github.com/j2h4u/ups-battery-monitor
After=sysinit.target network-online.target nut-server.service
Wants=network-online.target nut-driver@cyberpower-virtual.service
ConditionPathExists=/run/nut/
# Allow three bounded restart attempts in five minutes.  RestartSec=10 prevents
# a restart storm while still surfacing a persistent fatal safety failure.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
WatchdogSec=120
# User, WorkingDirectory, PYTHONPATH, and ReadWritePaths are filled in by install.sh (sudo bash scripts/install.sh).
User=@RUN_USER@
Group=@RUN_USER@
RuntimeDirectory=ups-battery-monitor
RuntimeDirectoryPreserve=restart
WorkingDirectory=@INSTALL_DIR@
Environment="PYTHONPATH=@INSTALL_DIR@"
ExecStart=/usr/bin/python3 -m src.monitor
# Remove a file left by an unclean shutdown before any bound dummy driver can
# observe it.  The driver is ordered after this service and waits for a fresh
# publication before starting.
ExecStartPre=-/usr/bin/unlink /run/ups-battery-monitor/ups-virtual.dev
# A stopped monitor must not leave dummy-ups serving its last OL snapshot.
# The target is a dedicated regular file under RuntimeDirectory; unlink is
# intentionally non-following and is ignored when the file is already absent.
ExecStopPost=-/usr/bin/unlink /run/ups-battery-monitor/ups-virtual.dev
Restart=on-failure
RestartSec=10
# NUT/output outages are degraded operation; Type=notify must not restart the
# daemon merely because its first successful READY notification is delayed.
TimeoutStartSec=0
StandardOutput=null
StandardError=journal
SyslogIdentifier=ups-battery-monitor

# Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@INSTALL_HOME@/.config/ups-battery-monitor/
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
UMask=0077

[Install]
WantedBy=multi-user.target
